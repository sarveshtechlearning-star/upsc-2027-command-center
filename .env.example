# --- Server-only, for the weekly review email (api/weekly-review-email.js) ---
# These are NOT prefixed with VITE_ on purpose: they must never be inlined
# into the client bundle. Set them in Vercel -> Settings -> Environment
# Variables, not in a local .env used by the Vite dev server.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
WEEKLY_REVIEW_EMAIL_TO=
# Optional — defaults to Resend's sandbox sender (only deliverable to the
# email address you signed up to Resend with, until you verify a domain).
EMAIL_FROM=
